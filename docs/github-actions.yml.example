name: Tests
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  test:
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest]
        python-version: ["3.9", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - run: python -m pip install -e .
      - run: python -m unittest discover -v
      - run: python examples/make_demo.py --output-dir demo_data
      - run: aigc-clear run --input demo_data/source.png --config demo_data/scope.json --proposal demo_data/proposal.png --output-dir runs/demo
      - run: aigc-clear audit --reference demo_data/source.png --image runs/demo/result.png --mask runs/demo/masks/mask.png
